APP_NAME="Observatório da Presidência"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_SECRET=defina-uma-chave-secreta-aleatoria-de-pelo-menos-32-caracteres

# Banco de Dados Principal (MySQL 8)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=observatorio_presidencia
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Driver Alternativo / Desenvolvimento Local (se MySQL não estiver ativo na máquina de testes)
# Pode ser configurado como sqlite para testes rápidos locais em storage/database.sqlite
DB_SQLITE_PATH=storage/database.sqlite

# Integrações Governamentais Oficiais
# Obtenha sua chave gratuita em https://portaldatransparencia.gov.br/api-de-dados/cadastrar-chave
TRANSPARENCIA_API_KEY=
TRANSPARENCIA_API_BASE=https://api.portaldatransparencia.gov.br/api-de-dados
BCB_API_BASE=https://api.bcb.gov.br/dados/serie/bcdata.sgs.433/dados

# Segurança e Sessão
SESSION_LIFETIME=7200
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_DECAY=60
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
